# ==============================================================================
# Setup TypoScript : Site Commune RGAA (Surcouche Bootstrap Package & News)
# ==============================================================================

page = PAGE
page {
  # Configuration HTML5 & Métadonnées mobiles / PWA
  config {
    htmlTag_setParams = lang="fr" dir="ltr"
    doctype = html5
    metaCharset = utf-8
    viewport = width=device-width, initial-scale=1, shrink-to-fit=no
    # Désactivation de la compression et fusion CSS/JS pour faciliter le débogage et le rechargement direct
    compressCss = 0
    concatenateCss = 0
    compressJs = 0
    concatenateJs = 0
  }

  # Métadonnées pour Application Mobile (PWA Android / iOS)
  meta {
    theme-color = #00703A
    mobile-web-app-capable = yes
    apple-mobile-web-app-capable = yes
    apple-mobile-web-app-status-bar-style = black-translucent
    apple-mobile-web-app-title = {$commune.pwa_app_name}
    application-name = {$commune.pwa_app_name}
  }

  # Déclaration du Web App Manifest et balise de débogage du thème
  headerData {
    10 = TEXT
    10.value = <link rel="manifest" href="/manifest.webmanifest">
    15 = TEXT
    15 {
      value = BLQcfzIu2XgG6fT4vVsRY6BYy1LgVkyKH8XYYJajIUts74MKtdOlZOZt2ZCs62LmUIUnaunEZPevfxIxIHzn_iY
      override.data = site:settings:commune.pwa_vapid_public_key
      wrap = <meta name="pwa-vapid-public-key" content="|">
    }
    99 = TEXT
    99 {
      data = site:settings:commune.theme_css
      ifEmpty.value = {$commune.theme_css}
      wrap = <!-- Theme actif: | -->
    }
  }

  # Inclusion des feuilles de styles de base conformes RGAA
  includeCSS {
    commune_accessibility = EXT:site_commune_rgaa/Resources/Public/Css/accessibility.css
    commune_print = EXT:site_commune_rgaa/Resources/Public/Css/print.css
    commune_print {
      media = print
    }
  }

  # Inclusion des scripts JavaScript d'accessibilité & PWA Notifications
  includeJSFooter {
    commune_a11y_toolbar = EXT:site_commune_rgaa/Resources/Public/JavaScript/accessibility-toolbar.js
    commune_a11y_toolbar {
      defer = 1
    }
    commune_a11y_nav = EXT:site_commune_rgaa/Resources/Public/JavaScript/navigation-a11y.js
    commune_a11y_nav {
      defer = 1
    }
    commune_a11y_carousel = EXT:site_commune_rgaa/Resources/Public/JavaScript/carousel-a11y.js
    commune_a11y_carousel {
      defer = 1
    }
    commune_pwa_notify = EXT:site_commune_rgaa/Resources/Public/JavaScript/pwa-notifications.js
    commune_pwa_notify {
      defer = 1
    }
  }

  # Configuration du FluidTemplate pour les gabarits de page
  10 = FLUIDTEMPLATE
  10 {
    templateName = TEXT
    templateName {
      cObject = CASE
      cObject {
        key.data = pagelayout

        pagets__commune_home = TEXT
        pagets__commune_home.value = Home

        commune_home = TEXT
        commune_home.value = Home

        pagets__commune_subpage = TEXT
        pagets__commune_subpage.value = Subpage

        commune_subpage = TEXT
        commune_subpage.value = Subpage

        pagets__commune_default = TEXT
        pagets__commune_default.value = Default

        commune_default = TEXT
        commune_default.value = Default

        default = TEXT
        default.value = Default
      }
      ifEmpty = Default
    }

    templateRootPaths {
      10 = EXT:bootstrap_package/Resources/Private/Templates/Page/
      20 = {$page.theme.templateRootPath}
    }

    partialRootPaths {
      10 = EXT:bootstrap_package/Resources/Private/Partials/Page/
      20 = {$page.theme.partialRootPath}
    }

    layoutRootPaths {
      10 = EXT:bootstrap_package/Resources/Private/Layouts/Page/
      20 = {$page.theme.layoutRootPath}
    }

    # Processeurs de données pour les menus et arborescences (TYPO3 v12/v13)
    dataProcessing {
      110 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
      110 {
        special = directory
        special.value.data = site:rootPageId
        levels = 4
        expandAll = 1
        includeSpacer = 0
        as = sitemapTree
        excludeDoktypes = 199,254
      }

      120 = TYPO3\CMS\Frontend\DataProcessing\LanguageMenuProcessor
      120 {
        languages = auto
        as = languageNavigation
        addQueryString = 1
      }
    }

    # Variables injectées dans les templates Fluid
    variables {
      # Thème graphique sélectionné (priorité aux réglages de site, puis constantes)
      communeTheme = TEXT
      communeTheme {
        data = site:settings:commune.theme_css
        ifEmpty.data = site:settings.commune.theme_css
        ifEmpty.ifEmpty.value = {$commune.theme_css}
      }

      # Jeu de couleurs sélectionné
      communeColorScheme = TEXT
      communeColorScheme {
        data = site:settings:commune.color_scheme_css
        ifEmpty.data = site:settings.commune.color_scheme_css
        ifEmpty.ifEmpty.value = {$commune.color_scheme_css}
      }

      # Activer le sélecteur de thème & couleurs en frontend (Live Preview)
      communeEnableThemeSwitcher = TEXT
      communeEnableThemeSwitcher {
        data = site:settings:commune.enable_theme_switcher
        ifEmpty.data = site:settings.commune.enable_theme_switcher
        ifEmpty.ifEmpty.value = {$commune.enable_theme_switcher}
      }

      # Activer le bandeau supérieur PWA & Notifications
      communePwaTopBannerEnable = TEXT
      communePwaTopBannerEnable {
        data = site:settings:commune.pwa_top_banner_enable
        ifEmpty.data = site:settings.commune.pwa_top_banner_enable
        ifEmpty.ifEmpty.value = {$commune.pwa_top_banner_enable}
        ifEmpty.ifEmpty.ifEmpty.value = 1
      }

      # Texte personnalisé du bandeau supérieur PWA
      communePwaTopBannerText = TEXT
      communePwaTopBannerText {
        data = site:settings:commune.pwa_top_banner_text
        ifEmpty.data = site:settings.commune.pwa_top_banner_text
        ifEmpty.ifEmpty.value = {$commune.pwa_top_banner_text}
        ifEmpty.ifEmpty.ifEmpty.value = Installez l'application Mairie et recevez les alertes en direct sur votre écran.
      }

      # Afficher la croix de fermeture du bandeau supérieur PWA (0/1)
      communePwaTopBannerShowClose = TEXT
      communePwaTopBannerShowClose {
        data = site:settings:commune.pwa_top_banner_show_close
        ifEmpty.data = site:settings.commune.pwa_top_banner_show_close
        ifEmpty.ifEmpty.value = {$commune.pwa_top_banner_show_close}
        ifEmpty.ifEmpty.ifEmpty.value = 1
      }

      # Activer ou désactiver globalement l'envoi des notifications Push (0/1)
      communePwaPushEnable = TEXT
      communePwaPushEnable {
        data = site:settings:commune.pwa_push_enable
        ifEmpty.data = site:settings.commune.pwa_push_enable
        ifEmpty.ifEmpty.value = {$commune.pwa_push_enable}
        ifEmpty.ifEmpty.ifEmpty.value = 1
      }

      # Logo et personnalisation de marque
      communeLogoFile = TEXT
      communeLogoFile {
        data = site:settings:commune.logo_file
        ifEmpty.data = site:settings.commune.logo_file
        ifEmpty.ifEmpty.value = {$commune.logo_file}
      }

      communeLogoHeight = TEXT
      communeLogoHeight {
        data = site:settings:commune.logo_height
        ifEmpty.data = site:settings.commune.logo_height
        ifEmpty.ifEmpty.value = {$commune.logo_height}
      }

      communeHeaderHideTitle = TEXT
      communeHeaderHideTitle {
        data = site:settings:commune.header_hide_title
        ifEmpty.data = site:settings.commune.header_hide_title
        ifEmpty.ifEmpty.value = {$commune.header_hide_title}
      }

      communeHeaderHideSlogan = TEXT
      communeHeaderHideSlogan {
        data = site:settings:commune.header_hide_slogan
        ifEmpty.data = site:settings.commune.header_hide_slogan
        ifEmpty.ifEmpty.value = {$commune.header_hide_slogan}
      }

      communeHeaderLayout = TEXT
      communeHeaderLayout {
        data = site:settings:commune:header_layout
        ifEmpty.data = site:settings:commune.header_layout
        ifEmpty.ifEmpty.data = site:settings.commune.header_layout
        ifEmpty.ifEmpty.ifEmpty.value = {$commune.header_layout}
      }

      # Données de la commune
      communeNom = TEXT
      communeNom {
        data = site:settings:commune.nom
        ifEmpty.data = site:settings.commune.nom
        ifEmpty.ifEmpty.value = {$commune.nom}
      }

      communeSlogan = TEXT
      communeSlogan {
        data = site:settings:commune.slogan
        ifEmpty.data = site:settings.commune.slogan
        ifEmpty.ifEmpty.value = {$commune.slogan}
      }

      communeDepartement = TEXT
      communeDepartement {
        data = site:settings:commune.departement
        ifEmpty.data = site:settings.commune.departement
        ifEmpty.ifEmpty.value = {$commune.departement}
      }

      communeAdresse = TEXT
      communeAdresse {
        data = site:settings:commune.adresse
        ifEmpty.data = site:settings.commune.adresse
        ifEmpty.ifEmpty.value = {$commune.adresse}
      }

      communeTelephone = TEXT
      communeTelephone {
        data = site:settings:commune.telephone
        ifEmpty.data = site:settings.commune.telephone
        ifEmpty.ifEmpty.value = {$commune.telephone}
      }

      communeEmail = TEXT
      communeEmail {
        data = site:settings:commune.email
        ifEmpty.data = site:settings.commune.email
        ifEmpty.ifEmpty.value = {$commune.email}
      }

      communeHoraires = TEXT
      communeHoraires {
        data = site:settings:commune.horaires
        ifEmpty.data = site:settings.commune.horaires
        ifEmpty.ifEmpty.value = {$commune.horaires}
      }

      # Titres et visibilité des sections de la page d'accueil
      communeHomeHeroSearchEnable = TEXT
      communeHomeHeroSearchEnable {
        data = site:settings:commune.home_hero_search_enable
        ifEmpty.data = site:settings.commune.home_hero_search_enable
        ifEmpty.ifEmpty.value = {$commune.home_hero_search_enable}
      }

      communeHomeQuickaccessTitle = TEXT
      communeHomeQuickaccessTitle {
        data = site:settings:commune.home_quickaccess_title
        ifEmpty.data = site:settings.commune.home_quickaccess_title
        ifEmpty.ifEmpty.value = {$commune.home_quickaccess_title}
      }

      communeHomeQuickaccessHideTitle = TEXT
      communeHomeQuickaccessHideTitle {
        data = site:settings:commune.home_quickaccess_hide_title
        ifEmpty.data = site:settings.commune.home_quickaccess_hide_title
        ifEmpty.ifEmpty.value = {$commune.home_quickaccess_hide_title}
      }

      communeHomeEditoTitle = TEXT
      communeHomeEditoTitle {
        data = site:settings:commune.home_edito_title
        ifEmpty.data = site:settings.commune.home_edito_title
        ifEmpty.ifEmpty.value = {$commune.home_edito_title}
      }

      communeHomeEditoHideTitle = TEXT
      communeHomeEditoHideTitle {
        data = site:settings:commune.home_edito_hide_title
        ifEmpty.data = site:settings.commune.home_edito_hide_title
        ifEmpty.ifEmpty.value = {$commune.home_edito_hide_title}
      }

      # Titre et visibilité de la section Actualités à la une (Accueil)
      communeHomeFeaturedNewsTitle = TEXT
      communeHomeFeaturedNewsTitle {
        data = site:settings:commune.home_featured_news_title
        ifEmpty.data = site:settings.commune.home_featured_news_title
        ifEmpty.ifEmpty.value = {$commune.home_featured_news_title}
      }

      communeHomeFeaturedNewsHideTitle = TEXT
      communeHomeFeaturedNewsHideTitle {
        data = site:settings:commune.home_featured_news_hide_title
        ifEmpty.data = site:settings.commune.home_featured_news_hide_title
        ifEmpty.ifEmpty.value = {$commune.home_featured_news_hide_title}
      }

      communeHomeFeaturedNewsHideSection = TEXT
      communeHomeFeaturedNewsHideSection {
        data = site:settings:commune.home_featured_news_hide_section
        ifEmpty.data = site:settings.commune.home_featured_news_hide_section
        ifEmpty.ifEmpty.value = {$commune.home_featured_news_hide_section}
      }

      communeHomeNewsTitle = TEXT
      communeHomeNewsTitle {
        data = site:settings:commune.home_news_title
        ifEmpty.data = site:settings.commune.home_news_title
        ifEmpty.ifEmpty.value = {$commune.home_news_title}
      }

      communeHomeNewsHideTitle = TEXT
      communeHomeNewsHideTitle {
        data = site:settings:commune.home_news_hide_title
        ifEmpty.data = site:settings.commune.home_news_hide_title
        ifEmpty.ifEmpty.value = {$commune.home_news_hide_title}
      }

      communeHomeMapTitle = TEXT
      communeHomeMapTitle {
        data = site:settings:commune.home_map_title
        ifEmpty.data = site:settings.commune.home_map_title
        ifEmpty.ifEmpty.value = {$commune.home_map_title}
      }

      communeHomeMapHideTitle = TEXT
      communeHomeMapHideTitle {
        data = site:settings:commune.home_map_hide_title
        ifEmpty.data = site:settings.commune.home_map_hide_title
        ifEmpty.ifEmpty.value = {$commune.home_map_hide_title}
      }

      communeHomeSitemapEnable = TEXT
      communeHomeSitemapEnable {
        data = site:settings:commune.home_sitemap_enable
        ifEmpty.data = site:settings.commune.home_sitemap_enable
        ifEmpty.ifEmpty.value = {$commune.home_sitemap_enable}
      }

      communeHomeSitemapTitle = TEXT
      communeHomeSitemapTitle {
        data = site:settings:commune.home_sitemap_title
        ifEmpty.data = site:settings.commune.home_sitemap_title
        ifEmpty.ifEmpty.value = {$commune.home_sitemap_title}
      }

      communeHomeSitemapHideTitle = TEXT
      communeHomeSitemapHideTitle {
        data = site:settings:commune.home_sitemap_hide_title
        ifEmpty.data = site:settings.commune.home_sitemap_hide_title
        ifEmpty.ifEmpty.value = {$commune.home_sitemap_hide_title}
      }

      # Page de recherche
      communeSearchPageUid = TEXT
      communeSearchPageUid {
        data = site:settings:commune.search_page_uid
        ifEmpty.data = site:settings.commune.search_page_uid
        ifEmpty.ifEmpty.value = {$commune.search_page_uid}
      }

      # Accessibilité RGAA
      communeRgaaTitre = TEXT
      communeRgaaTitre {
        data = site:settings:commune.rgaa_titre
        ifEmpty.data = site:settings.commune.rgaa_titre
        ifEmpty.ifEmpty.value = {$commune.rgaa_titre}
      }

      communeRgaaStatut = TEXT
      communeRgaaStatut {
        data = site:settings:commune.rgaa_statut
        ifEmpty.data = site:settings.commune.rgaa_statut
        ifEmpty.ifEmpty.value = {$commune.rgaa_statut}
      }

      communeRgaaTaux = TEXT
      communeRgaaTaux {
        data = site:settings:commune.rgaa_taux
        ifEmpty.data = site:settings.commune.rgaa_taux
        ifEmpty.ifEmpty.value = {$commune.rgaa_taux}
      }

      communeRgaaPageUid = TEXT
      communeRgaaPageUid {
        data = site:settings:commune.rgaa_page_uid
        ifEmpty.data = site:settings.commune.rgaa_page_uid
        ifEmpty.ifEmpty.value = {$commune.rgaa_page_uid}
      }

      # Pied de page
      communeFooterCol1Title = TEXT
      communeFooterCol1Title {
        data = site:settings:commune.footer_col1_title
        ifEmpty.data = site:settings.commune.footer_col1_title
        ifEmpty.ifEmpty.value = {$commune.footer_col1_title}
      }

      communeFooterContactBtnTitle = TEXT
      communeFooterContactBtnTitle {
        data = site:settings:commune.footer_contact_btn_title
        ifEmpty.data = site:settings.commune.footer_contact_btn_title
        ifEmpty.ifEmpty.value = {$commune.footer_contact_btn_title}
      }

      communeFooterContactPageUid = TEXT
      communeFooterContactPageUid {
        data = site:settings:commune.footer_contact_page_uid
        ifEmpty.data = site:settings.commune.footer_contact_page_uid
        ifEmpty.ifEmpty.value = {$commune.footer_contact_page_uid}
      }

      communeFooterCol2Title = TEXT
      communeFooterCol2Title {
        data = site:settings:commune.footer_col2_title
        ifEmpty.data = site:settings.commune.footer_col2_title
        ifEmpty.ifEmpty.value = {$commune.footer_col2_title}
      }

      communeFooterCol3Title = TEXT
      communeFooterCol3Title {
        data = site:settings:commune.footer_col3_title
        ifEmpty.data = site:settings.commune.footer_col3_title
        ifEmpty.ifEmpty.value = {$commune.footer_col3_title}
      }

      communeFooterMapImage = TEXT
      communeFooterMapImage {
        data = site:settings:commune.footer_map_image
        ifEmpty.data = site:settings.commune.footer_map_image
        ifEmpty.ifEmpty.value = {$commune.footer_map_image}
      }

      communeFooterMapPageUid = TEXT
      communeFooterMapPageUid {
        data = site:settings:commune.footer_map_page_uid
        ifEmpty.data = site:settings.commune.footer_map_page_uid
        ifEmpty.ifEmpty.value = {$commune.footer_map_page_uid}
      }

      communeFooterFolderUid = TEXT
      communeFooterFolderUid {
        data = site:settings:commune.footer_folder_uid
        ifEmpty.data = site:settings.commune.footer_folder_uid
        ifEmpty.ifEmpty.value = {$commune.footer_folder_uid}
      }

      # Réseaux sociaux et options d'affichage
      communeSocialFacebook = TEXT
      communeSocialFacebook {
        data = site:settings:commune.social_facebook
        ifEmpty.data = site:settings.commune.social_facebook
        ifEmpty.ifEmpty.value = {$commune.social_facebook}
      }

      communeSocialInstagram = TEXT
      communeSocialInstagram {
        data = site:settings:commune.social_instagram
        ifEmpty.data = site:settings.commune.social_instagram
        ifEmpty.ifEmpty.value = {$commune.social_instagram}
      }

      communeSocialTwitter = TEXT
      communeSocialTwitter {
        data = site:settings:commune.social_twitter
        ifEmpty.data = site:settings.commune.social_twitter
        ifEmpty.ifEmpty.value = {$commune.social_twitter}
      }

      communeSocialYoutube = TEXT
      communeSocialYoutube {
        data = site:settings:commune.social_youtube
        ifEmpty.data = site:settings.commune.social_youtube
        ifEmpty.ifEmpty.value = {$commune.social_youtube}
      }

      communeHeaderSocialEnable = TEXT
      communeHeaderSocialEnable {
        data = site:settings:commune.header_social_enable
        ifEmpty.data = site:settings.commune.header_social_enable
        ifEmpty.ifEmpty.value = {$commune.header_social_enable}
      }

      communeFooterSocialEnable = TEXT
      communeFooterSocialEnable {
        data = site:settings:commune.footer_social_enable
        ifEmpty.data = site:settings.commune.footer_social_enable
        ifEmpty.ifEmpty.value = {$commune.footer_social_enable}
      }

      communeHeaderLanguageEnable = TEXT
      communeHeaderLanguageEnable {
        data = site:settings:commune.header_language_enable
        ifEmpty.data = site:settings.commune.header_language_enable
        ifEmpty.ifEmpty.value = {$commune.header_language_enable}
      }

      communeHeaderLanguagePosition = TEXT
      communeHeaderLanguagePosition {
        data = site:settings:commune.header_language_position
        ifEmpty.data = site:settings.commune.header_language_position
        ifEmpty.ifEmpty.value = {$commune.header_language_position}
      }

      # Rendu standard direct et robuste de toutes les colonnes de contenu TYPO3
      emergencyAlertContent = CONTENT
      emergencyAlertContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=100
        }
      }

      heroContent = CONTENT
      heroContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=110
        }
      }

      quickAccessContent = CONTENT
      quickAccessContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=120
        }
      }

      editoContent = CONTENT
      editoContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=115
        }
      }

      featuredNewsContent = CONTENT
      featuredNewsContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=125
        }
      }

      mainContent = CONTENT
      mainContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=0
        }
      }

      newsContent = CONTENT
      newsContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=130
        }
      }

      interactiveMapContent = CONTENT
      interactiveMapContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=140
        }
      }

      sidebarLeftContent = CONTENT
      sidebarLeftContent {
        table = tt_content
        select {
          orderBy = sorting
          where = {#colPos}=200
        }
      }

      # Menu principal accessible (Megamenu 3 niveaux)
      mainNavigation = HMENU
      mainNavigation {
        entryLevel = 0
        1 = TMENU
        1 {
          expAll = 1
          wrap = <ul class="navbar-nav mb-2 mb-lg-0" role="menubar">|</ul>
          NO {
            wrapItemAndSub = <li class="nav-item" role="none">|</li>
            ATagParams = class="nav-link" role="menuitem"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="nav-item active" role="none">|</li>
            ATagParams = class="nav-link active" role="menuitem" aria-current="page"
          }
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <li class="nav-item dropdown megamenu-item" role="none">|</li>
            ATagParams = class="nav-link dropdown-toggle" role="menuitem" aria-expanded="false" data-bs-toggle="dropdown"
          }
          ACTIFSUB = 1
          ACTIFSUB {
            wrapItemAndSub = <li class="nav-item dropdown megamenu-item active" role="none">|</li>
            ATagParams = class="nav-link dropdown-toggle active" role="menuitem" aria-expanded="false" aria-current="true" data-bs-toggle="dropdown"
          }
        }
        2 = TMENU
        2 {
          expAll = 1
          wrap = <div class="dropdown-menu megamenu-panel shadow-lg" role="menu"><div class="container-fluid px-2 px-lg-4"><div class="row g-3 g-lg-4">|</div></div></div>
          NO {
            wrapItemAndSub = <div class="col-12 col-md-6 col-lg-3 megamenu-col" role="none">|</div>
            ATagParams = class="megamenu-category-link" role="menuitem"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <div class="col-12 col-md-6 col-lg-3 megamenu-col active" role="none">|</div>
            ATagParams = class="megamenu-category-link active" role="menuitem" aria-current="page"
          }
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <div class="col-12 col-md-6 col-lg-3 megamenu-col" role="none">|</div>
            stdWrap.wrap = <div class="megamenu-category-header">|</div>
            ATagParams = class="megamenu-category-title" role="menuitem"
          }
          ACTIFSUB = 1
          ACTIFSUB {
            wrapItemAndSub = <div class="col-12 col-md-6 col-lg-3 megamenu-col active" role="none">|</div>
            stdWrap.wrap = <div class="megamenu-category-header">|</div>
            ATagParams = class="megamenu-category-title active" role="menuitem" aria-current="true"
          }
        }
        3 = TMENU
        3 {
          expAll = 1
          wrap = <ul class="megamenu-list list-unstyled mb-0" role="menu">|</ul>
          NO {
            wrapItemAndSub = <li class="megamenu-item-l3" role="none">|</li>
            ATagParams = class="megamenu-sublink" role="menuitem"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="megamenu-item-l3 active" role="none">|</li>
            ATagParams = class="megamenu-sublink active" role="menuitem" aria-current="page"
          }
          CUR = 1
          CUR {
            wrapItemAndSub = <li class="megamenu-item-l3 active" role="none">|</li>
            ATagParams = class="megamenu-sublink active" role="menuitem" aria-current="page"
          }
        }
      }

      # Menu secondaire / Navigation latérale pour sous-pages (multi-niveaux 1 à 3)
      subNavigation = HMENU
      subNavigation {
        entryLevel = 1
        1 = TMENU
        1 {
          wrap = <ul class="list-group list-group-flush commune-sidebar-menu level-1">|</ul>
          NO {
            wrapItemAndSub = <li class="list-group-item level-1-item">|</li>
            ATagParams = class="sidebar-link level-1-link"
          }
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <li class="list-group-item level-1-item has-children">|</li>
            linkWrap = <span class="sidebar-title-text">|</span>
            ATagParams = class="sidebar-link level-1-link is-parent"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="list-group-item level-1-item active-page">|</li>
            ATagParams = class="sidebar-link level-1-link active-link" aria-current="page"
          }
          CUR = 1
          CUR {
            wrapItemAndSub = <li class="list-group-item level-1-item active-page">|</li>
            ATagParams = class="sidebar-link level-1-link active-link" aria-current="page"
          }
          ACTIFSUB = 1
          ACTIFSUB {
            wrapItemAndSub = <li class="list-group-item level-1-item active-parent has-children">|</li>
            linkWrap = <span class="sidebar-title-text">|</span>
            ATagParams = class="sidebar-link level-1-link is-parent active-parent-link" aria-current="true"
          }
          CURIFSUB = 1
          CURIFSUB {
            wrapItemAndSub = <li class="list-group-item level-1-item active-page active-parent has-children">|</li>
            linkWrap = <span class="sidebar-title-text">|</span>
            ATagParams = class="sidebar-link level-1-link active-link is-parent" aria-current="page"
          }
        }
        2 = TMENU
        2 {
          wrap = <ul class="commune-sidebar-submenu level-2 list-unstyled mb-0">|</ul>
          NO {
            wrapItemAndSub = <li class="sidebar-subitem level-2-item">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-sublink level-2-link"
          }
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <li class="sidebar-subitem level-2-item has-children">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-sublink level-2-link is-parent"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="sidebar-subitem level-2-item active-page">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-sublink level-2-link active-link" aria-current="page"
          }
          CUR = 1
          CUR {
            wrapItemAndSub = <li class="sidebar-subitem level-2-item active-page">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-sublink level-2-link active-link" aria-current="page"
          }
          ACTIFSUB = 1
          ACTIFSUB {
            wrapItemAndSub = <li class="sidebar-subitem level-2-item active-parent has-children">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-sublink level-2-link is-parent active-parent-link" aria-current="true"
          }
          CURIFSUB = 1
          CURIFSUB {
            wrapItemAndSub = <li class="sidebar-subitem level-2-item active-page active-parent has-children">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-sublink level-2-link active-link is-parent" aria-current="page"
          }
        }
        3 = TMENU
        3 {
          wrap = <ul class="commune-sidebar-subsubmenu level-3 list-unstyled mb-0">|</ul>
          NO {
            wrapItemAndSub = <li class="sidebar-subsubitem level-3-item">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-subsublink level-3-link"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="sidebar-subsubitem level-3-item active-page">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-subsublink level-3-link active-link" aria-current="page"
          }
          CUR = 1
          CUR {
            wrapItemAndSub = <li class="sidebar-subsubitem level-3-item active-page">|</li>
            linkWrap = <span class="sidebar-item-text">|</span>
            ATagParams = class="sidebar-subsublink level-3-link active-link" aria-current="page"
          }
        }
      }

      # Menu dynamique de bas de page (généré depuis le dossier configuré, ex: [13] Pied de page)
      footerNavigation = HMENU
      footerNavigation {
        special = directory
        special.value = {$commune.footer_folder_uid}
        special.value.override.data = site:commune.footer_folder_uid
        1 = TMENU
        1 {
          wrap = <ul class="list-inline mb-0">|</ul>
          NO {
            wrapItemAndSub = <li class="list-inline-item">|</li><li class="list-inline-item separator text-white-50" aria-hidden="true">·</li>
            ATagParams = class="text-white-50 text-decoration-none"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="list-inline-item">|</li><li class="list-inline-item separator text-white-50" aria-hidden="true">·</li>
            ATagParams = class="text-white fw-bold text-decoration-none" aria-current="page"
          }
        }
      }

      # Plan du site pour la page d'accueil (Hiérarchisé jusqu'à 4 niveaux)
      sitemapNavigation = HMENU
      sitemapNavigation {
        special = directory
        special.value.data = site:rootPageId
        ifEmpty.special.value = 1
        excludeDoktypes = 199,254
        1 = TMENU
        1 {
          expAll = 1
          wrap = <div class="commune-sitemap-grid">|</div>
          NO {
            wrapItemAndSub = <div class="commune-sitemap-group"><div class="commune-sitemap-header">|</div></div>
            stdWrap.wrap = <h3 class="commune-sitemap-title">|</h3>
            ATagParams = class="commune-sitemap-title-link"
          }
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <div class="commune-sitemap-group"><div class="commune-sitemap-header">|</div></div>
            stdWrap.wrap = <h3 class="commune-sitemap-title">|</h3>
            ATagParams = class="commune-sitemap-title-link"
          }
        }
        2 = TMENU
        2 {
          expAll = 1
          wrap = <ul class="commune-sitemap-list list-unstyled" role="list">|</ul>
          NO {
            wrapItemAndSub = <li class="commune-sitemap-item level-2">|</li>
            ATagParams = class="commune-sitemap-link level-2"
          }
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <li class="commune-sitemap-item level-2 has-children">|</li>
            linkWrap = <span class="commune-sitemap-parent-label">| <span class="commune-sitemap-caret" aria-hidden="true">▾</span></span>
            ATagParams = class="commune-sitemap-link level-2 is-parent"
          }
        }
        3 = TMENU
        3 {
          expAll = 1
          wrap = <ul class="commune-sitemap-sublist list-unstyled" role="list">|</ul>
          NO {
            wrapItemAndSub = <li class="commune-sitemap-item level-3">|</li>
            linkWrap = <span class="commune-sitemap-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span><span class="commune-sitemap-item-text">|</span>
            ATagParams = class="commune-sitemap-link level-3"
          }
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <li class="commune-sitemap-item level-3 has-children">|</li>
            linkWrap = <span class="commune-sitemap-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span><span class="commune-sitemap-parent-label">| <span class="commune-sitemap-caret-sm" aria-hidden="true">▾</span></span>
            ATagParams = class="commune-sitemap-link level-3 is-parent"
          }
        }
        4 = TMENU
        4 {
          expAll = 1
          wrap = <ul class="commune-sitemap-subsublist list-unstyled" role="list">|</ul>
          NO {
            wrapItemAndSub = <li class="commune-sitemap-item level-4">|</li>
            linkWrap = <span class="commune-sitemap-icon-dot" aria-hidden="true">•</span><span class="commune-sitemap-item-text">|</span>
            ATagParams = class="commune-sitemap-link level-4"
          }
        }
      }
    }
  }
}

# ------------------------------------------------------------------------------
# Configuration de la surcouche pour EXT:news (georgringer/news)
# ------------------------------------------------------------------------------
plugin.tx_news {
  view {
    templateRootPaths {
      100 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Templates/
    }
    partialRootPaths {
      100 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Partials/
    }
    layoutRootPaths {
      100 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Layouts/
    }
  }
  settings {
    listLayout = {$commune.news_list_layout}
  }
}

# ------------------------------------------------------------------------------
# Surcharges des gabarits d'éléments de contenu de bootstrap_package
# ------------------------------------------------------------------------------
lib.contentElement {
  templateRootPaths {
    100 = EXT:site_commune_rgaa/Resources/Private/OverriddenTemplates/BootstrapPackage/ContentElements/
  }
  partialRootPaths {
    100 = EXT:site_commune_rgaa/Resources/Private/Partials/ContentElements/
  }
}

# ------------------------------------------------------------------------------
# Inclusion de la configuration de l'extension hCaptcha pour EXT:form
# ------------------------------------------------------------------------------
@import 'EXT:hcaptcha/Configuration/TypoScript/setup.typoscript'

