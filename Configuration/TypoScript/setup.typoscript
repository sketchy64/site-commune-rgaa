# ==============================================================================
# Setup TypoScript : Site Commune RGAA (Surcouche Bootstrap Package & News)
# ==============================================================================

page = PAGE
page {
  # Configuration HTML5 & Métadonnées mobiles / PWA
  config {
    htmlTag_setParams = lang="fr" dir="ltr"
    doctype = html5
    metaCharset = utf-8
    viewport = width=device-width, initial-scale=1, shrink-to-fit=no
  }

  # Métadonnées pour Application Mobile (PWA Android / iOS)
  meta {
    theme-color = #00703A
    apple-mobile-web-app-capable = yes
    apple-mobile-web-app-status-bar-style = black-translucent
    apple-mobile-web-app-title = {$commune.pwa_app_name}
    application-name = {$commune.pwa_app_name}
  }

  # Déclaration du Web App Manifest pour installation smartphone
  headerData {
    10 = TEXT
    10.value = <link rel="manifest" href="/manifest.webmanifest">
  }

  # Inclusion des feuilles de styles conformes RGAA & Thème Sauveterre
  includeCSS {
    commune_theme = EXT:site_commune_rgaa/Resources/Public/Css/commune-theme.css
    commune_accessibility = EXT:site_commune_rgaa/Resources/Public/Css/accessibility.css
    commune_print = EXT:site_commune_rgaa/Resources/Public/Css/print.css
    commune_print {
      media = print
    }
  }

  # Inclusion des scripts JavaScript d'accessibilité & PWA Notifications
  includeJSFooter {
    commune_a11y_toolbar = EXT:site_commune_rgaa/Resources/Public/JavaScript/accessibility-toolbar.js
    commune_a11y_toolbar {
      defer = 1
    }
    commune_a11y_nav = EXT:site_commune_rgaa/Resources/Public/JavaScript/navigation-a11y.js
    commune_a11y_nav {
      defer = 1
    }
    commune_a11y_carousel = EXT:site_commune_rgaa/Resources/Public/JavaScript/carousel-a11y.js
    commune_a11y_carousel {
      defer = 1
    }
    commune_pwa_notify = EXT:site_commune_rgaa/Resources/Public/JavaScript/pwa-notifications.js
    commune_pwa_notify {
      defer = 1
    }
  }

  # Configuration du FluidTemplate pour les gabarits de page
  10 = FLUIDTEMPLATE
  10 {
    templateName = TEXT
    templateName {
      cObject = CASE
      cObject {
        key.data = levelfield:-1, backend_layout_next_level, slide
        key.override.field = backend_layout

        commune_home = TEXT
        commune_home.value = Home

        commune_subpage = TEXT
        commune_subpage.value = Subpage

        commune_default = TEXT
        commune_default.value = Default

        default = TEXT
        default.value = Default
      }
      ifEmpty = Default
    }

    templateRootPaths {
      10 = EXT:bootstrap_package/Resources/Private/Templates/Page/
      20 = {$page.theme.templateRootPath}
    }

    partialRootPaths {
      10 = EXT:bootstrap_package/Resources/Private/Partials/Page/
      20 = {$page.theme.partialRootPath}
    }

    layoutRootPaths {
      10 = EXT:bootstrap_package/Resources/Private/Layouts/Page/
      20 = {$page.theme.layoutRootPath}
    }

    # Variables injectées dans les templates Fluid
    variables {
      # Données de la commune
      communeNom = TEXT
      communeNom.value = {$commune.nom}
      communeNom.override.data = site:commune.nom

      communeSlogan = TEXT
      communeSlogan.value = {$commune.slogan}
      communeSlogan.override.data = site:commune.slogan

      communeDepartement = TEXT
      communeDepartement.value = {$commune.departement}
      communeDepartement.override.data = site:commune.departement

      communeAdresse = TEXT
      communeAdresse.value = {$commune.adresse}
      communeAdresse.override.data = site:commune.adresse

      communeTelephone = TEXT
      communeTelephone.value = {$commune.telephone}
      communeTelephone.override.data = site:commune.telephone

      communeEmail = TEXT
      communeEmail.value = {$commune.email}
      communeEmail.override.data = site:commune.email

      communeHoraires = TEXT
      communeHoraires.value = {$commune.horaires}
      communeHoraires.override.data = site:commune.horaires

      # Accessibilité RGAA
      communeRgaaTitre = TEXT
      communeRgaaTitre.value = {$commune.rgaa_titre}
      communeRgaaTitre.override.data = site:commune.rgaa_titre

      communeRgaaStatut = TEXT
      communeRgaaStatut.value = {$commune.rgaa_statut}
      communeRgaaStatut.override.data = site:commune.rgaa_statut

      communeRgaaTaux = TEXT
      communeRgaaTaux.value = {$commune.rgaa_taux}
      communeRgaaTaux.override.data = site:commune.rgaa_taux

      communeRgaaPageUid = TEXT
      communeRgaaPageUid.value = {$commune.rgaa_page_uid}
      communeRgaaPageUid.override.data = site:commune.rgaa_page_uid

      # Pied de page
      communeFooterFolderUid = TEXT
      communeFooterFolderUid.value = {$commune.footer_folder_uid}
      communeFooterFolderUid.override.data = site:commune.footer_folder_uid

      communeFooterMapTitle = TEXT
      communeFooterMapTitle.value = {$commune.footer_map_title}
      communeFooterMapTitle.override.data = site:commune.footer_map_title

      communeFooterMapPageUid = TEXT
      communeFooterMapPageUid.value = {$commune.footer_map_page_uid}
      communeFooterMapPageUid.override.data = site:commune.footer_map_page_uid

      # Rendu standard robuste de toutes les colonnes de contenu TYPO3
      emergencyAlertContent =< styles.content.get
      emergencyAlertContent.select.where = {#colPos} = 100

      heroContent =< styles.content.get
      heroContent.select.where = {#colPos} = 110

      quickAccessContent =< styles.content.get
      quickAccessContent.select.where = {#colPos} = 120

      mainContent =< styles.content.get
      mainContent.select.where = {#colPos} = 0

      newsContent =< styles.content.get
      newsContent.select.where = {#colPos} = 130

      interactiveMapContent =< styles.content.get
      interactiveMapContent.select.where = {#colPos} = 140

      sidebarLeftContent =< styles.content.get
      sidebarLeftContent.select.where = {#colPos} = 200

      # Menu principal accessible
      mainNavigation = HMENU
      mainNavigation {
        entryLevel = 0
        1 = TMENU
        1 {
          expAll = 1
          wrap = <ul class="navbar-nav me-auto mb-2 mb-lg-0" role="menubar">|</ul>
          NO {
            wrapItemAndSub = <li class="nav-item" role="none">|</li>
            ATagParams = class="nav-link" role="menuitem"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="nav-item active" role="none">|</li>
            ATagParams = class="nav-link active" role="menuitem" aria-current="page"
          }
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <li class="nav-item dropdown" role="none">|</li>
            ATagParams = class="nav-link dropdown-toggle" role="menuitem" aria-expanded="false" data-bs-toggle="dropdown"
          }
          ACTIFSUB = 1
          ACTIFSUB {
            wrapItemAndSub = <li class="nav-item dropdown active" role="none">|</li>
            ATagParams = class="nav-link dropdown-toggle active" role="menuitem" aria-expanded="false" aria-current="true" data-bs-toggle="dropdown"
          }
        }
        2 = TMENU
        2 {
          wrap = <ul class="dropdown-menu" role="menu">|</ul>
          NO {
            wrapItemAndSub = <li role="none">|</li>
            ATagParams = class="dropdown-item" role="menuitem"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li role="none">|</li>
            ATagParams = class="dropdown-item active" role="menuitem" aria-current="page"
          }
        }
      }

      # Menu secondaire / Navigation latérale pour sous-pages
      subNavigation = HMENU
      subNavigation {
        entryLevel = 1
        1 = TMENU
        1 {
          wrap = <ul class="list-group list-group-flush commune-sidebar-menu">|</ul>
          NO {
            wrapItemAndSub = <li class="list-group-item">|</li>
            ATagParams = class="text-decoration-none"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="list-group-item active-page" aria-current="page">|</li>
            ATagParams = class="text-decoration-none fw-bold"
          }
        }
      }

      # Menu dynamique de bas de page (généré depuis le dossier configuré, ex: [13] Pied de page)
      footerNavigation = HMENU
      footerNavigation {
        special = directory
        special.value = {$commune.footer_folder_uid}
        special.value.override.data = site:commune.footer_folder_uid
        1 = TMENU
        1 {
          wrap = <ul class="list-inline mb-0">|</ul>
          NO {
            wrapItemAndSub = <li class="list-inline-item">|</li><li class="list-inline-item separator text-white-50" aria-hidden="true">·</li>
            ATagParams = class="text-white-50 text-decoration-none"
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="list-inline-item">|</li><li class="list-inline-item separator text-white-50" aria-hidden="true">·</li>
            ATagParams = class="text-white fw-bold text-decoration-none" aria-current="page"
          }
        }
      }
    }
  }
}

# ------------------------------------------------------------------------------
# Configuration de la surcouche pour EXT:news (georgringer/news)
# ------------------------------------------------------------------------------
plugin.tx_news {
  view {
    templateRootPaths {
      100 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Templates/
    }
    partialRootPaths {
      100 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Partials/
    }
    layoutRootPaths {
      100 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Layouts/
    }
  }
}

# ------------------------------------------------------------------------------
# Surcharges des gabarits d'éléments de contenu de bootstrap_package
# ------------------------------------------------------------------------------
lib.contentElement {
  templateRootPaths {
    100 = EXT:site_commune_rgaa/Resources/Private/OverriddenTemplates/BootstrapPackage/ContentElements/
  }
}
