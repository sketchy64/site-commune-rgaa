# ==============================================================================
# Configuration TypoScript Globale - Site Commune RGAA
# ==============================================================================

# Configuration du moteur de rendu de page (PAGE)
page = PAGE
page {
  # Balise meta viewport pour le responsive design (Critère 10.4 RGAA)
  meta {
    viewport = width=device-width, initial-scale=1.0, shrink-to-fit=no
    robots = index,follow
    generator = TYPO3 CMS - Site Commune RGAA
    description = Site officiel de la commune - Conforme aux normes d'accessibilité numérique RGAA 4.1.2
    theme-color = #00703A
    mobile-web-app-capable = yes
    apple-mobile-web-app-capable = yes
    apple-mobile-web-app-status-bar-style = default
    apple-mobile-web-app-title = Sauveterre
    application-name = Sauveterre-de-Béarn
  }

  # Inclusion du Manifest PWA
  headerData {
    10 = TEXT
    10.value = <link rel="manifest" href="/manifest.webmanifest">
    20 = TEXT
    20.value = <link rel="apple-touch-icon" href="/typo3conf/ext/site_commune_rgaa/Resources/Public/Icons/icon-192x192.png">
    
    # Inclusion dynamique de la feuille de style du thème actif (depuis les constantes)
    30 = TEXT
    30 {
      data = site:settings:commune.theme_css
      ifEmpty.value = {$commune.theme_css}
      wrap = <!-- Theme actif: | -->
    }
  }

  # Inclusion des feuilles de styles de base conformes RGAA
  includeCSS {
    commune_accessibility = EXT:site_commune_rgaa/Resources/Public/Css/accessibility.css
    commune_print = EXT:site_commune_rgaa/Resources/Public/Css/print.css
    commune_print {
      media = print
    }
  }

  # Inclusion des scripts JavaScript d'accessibilité & PWA Notifications
  includeJSFooter {
    commune_a11y_toolbar = EXT:site_commune_rgaa/Resources/Public/JavaScript/accessibility-toolbar.js
    commune_a11y_toolbar {
      defer = 1
    }
    commune_a11y_nav = EXT:site_commune_rgaa/Resources/Public/JavaScript/navigation-a11y.js
    commune_a11y_nav {
      defer = 1
    }
    commune_a11y_carousel = EXT:site_commune_rgaa/Resources/Public/JavaScript/carousel-a11y.js
    commune_a11y_carousel {
      defer = 1
    }
    commune_a11y_lightbox = EXT:site_commune_rgaa/Resources/Public/JavaScript/lightbox-a11y.js
    commune_a11y_lightbox {
      defer = 1
    }
    commune_pwa_notify = EXT:site_commune_rgaa/Resources/Public/JavaScript/pwa-notifications.js
    commune_pwa_notify {
      defer = 1
    }
  }

  # Configuration du FluidTemplate pour les gabarits de page
  10 = FLUIDTEMPLATE
  10 {
    templateName = TEXT
    templateName {
      cObject = CASE
      cObject {
        key.data = pagelayout
        
        # Gabarit Page d'accueil
        pagets__commune_home = TEXT
        pagets__commune_home.value = Home
        
        # Gabarit Page standard (Contenu + Sous-navigation latérale)
        pagets__commune_standard = TEXT
        pagets__commune_standard.value = Standard
        
        # Gabarit Page pleine largeur
        pagets__commune_fullwidth = TEXT
        pagets__commune_fullwidth.value = FullWidth
        
        # Gabarit Page Démarches & Services
        pagets__commune_demarches = TEXT
        pagets__commune_demarches.value = Demarches
        
        # Gabarit Page Annuaire des Élus / Services
        pagets__commune_directory = TEXT
        pagets__commune_directory.value = Directory
        
        # Gabarit Page Agenda / Événements
        pagets__commune_events = TEXT
        pagets__commune_events.value = Events
        
        # Gabarit Page Publications / Délibérations (Documents téléchargeables RGAA)
        pagets__commune_publications = TEXT
        pagets__commune_publications.value = Publications
        
        # Gabarit par défaut
        default = TEXT
        default.value = Standard
      }
    }
    
    templateRootPaths {
      0 = EXT:site_commune_rgaa/Resources/Private/Templates/Page/
      1 = {$commune.templates.pageRootPath}
    }
    
    partialRootPaths {
      0 = EXT:site_commune_rgaa/Resources/Private/Partials/Page/
      1 = {$commune.partials.pageRootPath}
    }
    
    layoutRootPaths {
      0 = EXT:site_commune_rgaa/Resources/Private/Layouts/Page/
      1 = {$commune.layouts.pageRootPath}
    }
    
    # Variables passées automatiquement à tous les gabarits Fluid
    variables {
      # Informations sur la commune issues des constantes TypoScript
      communeName = TEXT
      communeName.value = {$commune.name}
      
      communeSlogan = TEXT
      communeSlogan.value = {$commune.slogan}
      
      communeDepartment = TEXT
      communeDepartment.value = {$commune.department}
      
      communeLogo = TEXT
      communeLogo.value = {$commune.logo}
      
      communeAddress = TEXT
      communeAddress.value = {$commune.contact.address}
      
      communePostalCode = TEXT
      communePostalCode.value = {$commune.contact.postalCode}
      
      communeCity = TEXT
      communeCity.value = {$commune.contact.city}
      
      communePhone = TEXT
      communePhone.value = {$commune.contact.phone}
      
      communeEmail = TEXT
      communeEmail.value = {$commune.contact.email}
      
      communeOpeningHours = TEXT
      communeOpeningHours.value = {$commune.contact.openingHours}
      
      communeMayorName = TEXT
      communeMayorName.value = {$commune.mayor.name}
      
      communeMayorPhoto = TEXT
      communeMayorPhoto.value = {$commune.mayor.photo}
      
      communeMayorMessage = TEXT
      communeMayorMessage.value = {$commune.mayor.message}
      
      communeA11yStatus = TEXT
      communeA11yStatus.value = {$commune.a11y.status}
      
      communeA11yRate = TEXT
      communeA11yRate.value = {$commune.a11y.complianceRate}
      
      communeEmergencySamu = TEXT
      communeEmergencySamu.value = {$commune.emergency.samu}
      
      communeEmergencyPolice = TEXT
      communeEmergencyPolice.value = {$commune.emergency.police}
      
      communeEmergencyPompiers = TEXT
      communeEmergencyPompiers.value = {$commune.emergency.pompiers}
      
      communeEmergencyEurope = TEXT
      communeEmergencyEurope.value = {$commune.emergency.europe}
      
      communeEmergencySourds = TEXT
      communeEmergencySourds.value = {$commune.emergency.sourds}

      # Paramètres d'activation des fonctionnalités
      enableEmergencyBanner = TEXT
      enableEmergencyBanner.value = {$commune.enableEmergencyBanner}
      
      enableA11yToolbar = TEXT
      enableA11yToolbar.value = {$commune.enableA11yToolbar}
      
      enablePwa = TEXT
      enablePwa.value = {$commune.enablePwa}

      enablePushNotifications = TEXT
      enablePushNotifications.value = {$commune.enablePushNotifications}
      
      enableQuickAccess = TEXT
      enableQuickAccess.value = {$commune.enableQuickAccess}
      
      enableInteractiveMap = TEXT
      enableInteractiveMap.value = {$commune.enableInteractiveMap}
      
      enableUpcomingEvents = TEXT
      enableUpcomingEvents.value = {$commune.enableUpcomingEvents}
      
      enableSocialWall = TEXT
      enableSocialWall.value = {$commune.enableSocialWall}

      # Section actualités à la une en page d'accueil
      enableFeaturedNews = TEXT
      enableFeaturedNews.value = {$commune.enableFeaturedNews}

      featuredNewsTitle = TEXT
      featuredNewsTitle.value = {$commune.featuredNews.title}

      # Menu de navigation principale accessible (Critères 12.1 à 12.11 RGAA)
      mainNavigation = HMENU
      mainNavigation {
        1 = TMENU
        1 {
          expAll = 1
          NO = 1
          NO {
            wrapItemAndSub = <li class="nav-item">|</li>
            ATagParams = class="nav-link"
            ATagTitle.field = subtitle // title
            stdWrap.htmlSpecialChars = 1
          }
          
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="nav-item active">|</li>
            ATagParams = class="nav-link active" aria-current="page"
            ATagTitle.field = subtitle // title
            stdWrap.htmlSpecialChars = 1
          }
          
          IFSUB = 1
          IFSUB {
            wrapItemAndSub = <li class="nav-item dropdown">|</li>
            ATagParams = class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false" id="nav-dropdown-{field:uid}"
            ATagParams.insertData = 1
            ATagTitle.field = subtitle // title
            stdWrap.htmlSpecialChars = 1
          }
          
          ACTIFSUB = 1
          ACTIFSUB {
            wrapItemAndSub = <li class="nav-item dropdown active">|</li>
            ATagParams = class="nav-link dropdown-toggle active" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-current="true" id="nav-dropdown-{field:uid}"
            ATagParams.insertData = 1
            ATagTitle.field = subtitle // title
            stdWrap.htmlSpecialChars = 1
          }
        }
        
        2 = TMENU
        2 {
          wrap = <ul class="dropdown-menu shadow" aria-labelledby="nav-dropdown-{field:pid}">|</ul>
          wrap.insertData = 1
          
          NO = 1
          NO {
            wrapItemAndSub = <li>|</li>
            ATagParams = class="dropdown-item"
            ATagTitle.field = subtitle // title
            stdWrap.htmlSpecialChars = 1
          }
          
          ACT = 1
          ACT {
            wrapItemAndSub = <li>|</li>
            ATagParams = class="dropdown-item active" aria-current="page"
            ATagTitle.field = subtitle // title
            stdWrap.htmlSpecialChars = 1
          }
        }
      }
      
      # Menu d'accès rapide (Pied de page / Entête)
      quickAccessMenu = HMENU
      quickAccessMenu {
        special = directory
        special.value = {$commune.pages.quickAccess}
        1 = TMENU
        1 {
          NO = 1
          NO {
            wrapItemAndSub = <li class="quick-access-item">|</li>
            ATagParams = class="quick-access-link"
            stdWrap.htmlSpecialChars = 1
          }
        }
      }
      
      # Menu du pied de page (Mentions légales, RGAA, Plan du site, etc.)
      footerNavigation = HMENU
      footerNavigation {
        special = directory
        special.value = {$commune.pages.footer}
        1 = TMENU
        1 {
          NO = 1
          NO {
            wrapItemAndSub = <li class="footer-nav-item">|</li>
            ATagParams = class="footer-nav-link"
            stdWrap.htmlSpecialChars = 1
          }
        }
      }
      
      # Fil d'Ariane accessible (Critère 12.8 RGAA)
      breadcrumb = HMENU
      breadcrumb {
        special = rootline
        special.range = 0|-1
        1 = TMENU
        1 {
          wrap = <nav aria-label="Fil d'Ariane" class="commune-breadcrumb"><ol class="breadcrumb mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">|</ol></nav>
          NO = 1
          NO {
            wrapItemAndSub = <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">|</li>
            ATagParams = itemprop="item"
            stdWrap.htmlSpecialChars = 1
            stdWrap.wrap = <span itemprop="name">|</span>
          }
          CUR = 1
          CUR {
            wrapItemAndSub = <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><span itemprop="name">|</span></li>
            stdWrap.htmlSpecialChars = 1
            doNotLinkIt = 1
          }
        }
      }
      
      # Sous-navigation contextuelle (Page standard avec menu latéral)
      subNavigation = HMENU
      subNavigation {
        entryLevel = 1
        1 = TMENU
        1 {
          wrap = <nav aria-label="Menu de la rubrique" class="commune-subnav"><ul class="nav flex-column subnav-list">|</ul></nav>
          NO = 1
          NO {
            wrapItemAndSub = <li class="nav-item">|</li>
            ATagParams = class="nav-link subnav-link"
            stdWrap.htmlSpecialChars = 1
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="nav-item active">|</li>
            ATagParams = class="nav-link subnav-link active" aria-current="page"
            stdWrap.htmlSpecialChars = 1
          }
        }
        2 = TMENU
        2 {
          wrap = <ul class="nav flex-column subnav-sublist ms-3">|</ul>
          NO = 1
          NO {
            wrapItemAndSub = <li class="nav-item">|</li>
            ATagParams = class="nav-link subnav-sublink"
            stdWrap.htmlSpecialChars = 1
          }
          ACT = 1
          ACT {
            wrapItemAndSub = <li class="nav-item active">|</li>
            ATagParams = class="nav-link subnav-sublink active" aria-current="page"
            stdWrap.htmlSpecialChars = 1
          }
        }
      }
      
      # Contenu principal (colPos = 0)
      mainContent = COA
      mainContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=0
      }
      
      # Contenu Bandeau Hero / Carousel / Image d'en-tête (colPos = 100)
      heroContent = COA
      heroContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=100
      }
      
      # Contenu Mot du Maire (colPos = 110)
      mayorContent = COA
      mayorContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=110
      }

      # Contenu Actualités à la une (colPos = 125)
      featuredNewsContent = COA
      featuredNewsContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=125
      }

      # Contenu Accès Rapides (colPos = 120)
      quickAccessContent = COA
      quickAccessContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=120
      }
      
      # Contenu Kiosque / Démarches phares (colPos = 130)
      kiosqueContent = COA
      kiosqueContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=130
      }
      
      # Contenu Carte Interactive / Découverte (colPos = 140)
      mapContent = COA
      mapContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=140
      }
      
      # Contenu Événements / Agenda (colPos = 150)
      eventsContent = COA
      eventsContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=150
      }
      
      # Contenu Barre latérale (colPos = 1)
      sidebarContent = COA
      sidebarContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=1
      }
      
      # Contenu Pied de page (colPos = 2)
      footerContent = COA
      footerContent {
        10 =< styles.content.get
        10.select.where = {#colPos}=2
      }
    }
  }
}

# Configuration du moteur de recherche Indexed Search conforme RGAA
plugin.tx_indexedsearch {
  templateRootPaths {
    0 = EXT:indexed_search/Resources/Private/Templates/
    1 = EXT:site_commune_rgaa/Resources/Private/Extensions/IndexedSearch/Templates/
  }
  partialRootPaths {
    0 = EXT:indexed_search/Resources/Private/Partials/
    1 = EXT:site_commune_rgaa/Resources/Private/Extensions/IndexedSearch/Partials/
  }
  _CSS_DEFAULT_STYLE >
}

# Configuration de l'extension EXT:news conforme RGAA
plugin.tx_news {
  view {
    templateRootPaths {
      0 = EXT:news/Resources/Private/Templates/
      1 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Templates/
    }
    partialRootPaths {
      0 = EXT:news/Resources/Private/Partials/
      1 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Partials/
    }
    layoutRootPaths {
      0 = EXT:news/Resources/Private/Layouts/
      1 = EXT:site_commune_rgaa/Resources/Private/Extensions/News/Layouts/
    }
  }
  settings {
    cssFile >
    displayDummyIfNoMedia = 1
    list {
      media {
        image {
          maxWidth = 600
          maxHeight = 400
        }
      }
      paginate {
        insertAbove = 0
        insertBelow = 1
        prevNextHeaderTags = 1
      }
    }
    detail {
      media {
        image {
          maxWidth = 1200
          maxHeight = 800
        }
      }
    }
  }
}

# Configuration de l'extension EXT:form conforme RGAA
plugin.tx_form {
  settings {
    yamlConfigurations {
      100 = EXT:site_commune_rgaa/Configuration/Yaml/FormSetup.yaml
    }
  }
}

# ==============================================================================
# Overrides pour le rendu des médias et images (Critères 1.1 à 1.9 RGAA)
# ==============================================================================
tt_content.image.20 {
  1 {
    altText {
      field = alternative // title // description
      htmlSpecialChars = 1
    }
    titleText {
      field = title // alternative
      htmlSpecialChars = 1
    }
  }
}

tt_content.textmedia.dataProcessing {
  20 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
  20 {
    references.fieldName = assets
    as = files
  }
}
