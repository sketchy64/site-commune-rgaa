mod.web_layout.BackendLayouts {
  commune_subpage {
    title = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:backend_layout.subpage
    icon = EXT:site_commune_rgaa/Resources/Public/Icons/Extension.svg
    config {
      backend_layout {
        colCount = 3
        rowCount = 2
        rows {
          1 {
            columns {
              1 {
                name = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:backend_layout.column.alert
                colPos = 100
                colspan = 3
                maxitems = 1
              }
            }
          }
          2 {
            columns {
              1 {
                name = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:backend_layout.column.sidebar_left
                colPos = 200
                colspan = 1
              }
              2 {
                name = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:backend_layout.column.main
                colPos = 0
                colspan = 2
              }
            }
          }
        }
      }
    }
  }
}
