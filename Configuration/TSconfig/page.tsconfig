# Suppression intégrale des Backend Layouts hérités (notamment ceux de bootstrap_package)
mod.web_layout.BackendLayouts >

# Import exclusif des 4 Backend Layouts de l'extension (2 Accueil + 2 Contenu)
@import 'EXT:site_commune_rgaa/Configuration/TSconfig/BackendLayouts/commune_home.tsconfig'
@import 'EXT:site_commune_rgaa/Configuration/TSconfig/BackendLayouts/commune_home_2.tsconfig'
@import 'EXT:site_commune_rgaa/Configuration/TSconfig/BackendLayouts/commune_subpage.tsconfig'
@import 'EXT:site_commune_rgaa/Configuration/TSconfig/BackendLayouts/commune_default.tsconfig'

# Masquage explicite dans TCEFORM de tout layout issu de bootstrap_package
TCEFORM.pages {
  backend_layout {
    removeItems = -1,default,2_columns,2_columns_25_75,2_columns_50_50,2_columns_offset_right,3_columns,simple,special_feature,special_start,subnavigation_left,subnavigation_right,subnavigation_right_2_columns,subnavigation_left_2_columns,pagets__default,pagets__2_columns,pagets__2_columns_25_75,pagets__2_columns_50_50,pagets__2_columns_offset_right,pagets__3_columns,pagets__simple,pagets__special_feature,pagets__special_start,pagets__subnavigation_left,pagets__subnavigation_right,pagets__subnavigation_right_2_columns,pagets__subnavigation_left_2_columns
  }
  backend_layout_next_level {
    removeItems = -1,default,2_columns,2_columns_25_75,2_columns_50_50,2_columns_offset_right,3_columns,simple,special_feature,special_start,subnavigation_left,subnavigation_right,subnavigation_right_2_columns,subnavigation_left_2_columns,pagets__default,pagets__2_columns,pagets__2_columns_25_75,pagets__2_columns_50_50,pagets__2_columns_offset_right,pagets__3_columns,pagets__simple,pagets__special_feature,pagets__special_start,pagets__subnavigation_left,pagets__subnavigation_right,pagets__subnavigation_right_2_columns,pagets__subnavigation_left_2_columns
  }
}

# Configuration TCEFORM pour conformité RGAA (Critère 9.1 - Hiérarchie des titres)
TCEFORM.tt_content {
  header_layout {
    # 0 = Défaut (H2 pour le contenu), 1 = H1 (réservé pour page sans h1 système), 2 = H2, 3 = H3, 4 = H4, 100 = Caché accessible
    altLabels {
      1 = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:tceform.header_layout.h1
      2 = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:tceform.header_layout.h2
      3 = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:tceform.header_layout.h3
      4 = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:tceform.header_layout.h4
      5 = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:tceform.header_layout.h5
      100 = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:tceform.header_layout.hidden
    }
  }
}

# Layouts de gabarit pour EXT:news
tx_news.templateLayouts {
  cards = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:news.templateLayout.cards
  rows = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:news.templateLayout.rows
  carousel = LLL:EXT:site_commune_rgaa/Resources/Private/Language/locallang_be.xlf:news.templateLayout.carousel
}
